# ──────────────────────────────────────────────────────────────────────
# Nenyere ECD Digital Learning Platform — Environment Variables
# Copy to .env.local and fill in values.
# See docs/deployment.md §3 for details.
# ──────────────────────────────────────────────────────────────────────

# Supabase (public — safe for client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://achswnzuqutjxdhpnacs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sIPEr_c3ZDArmCNb6IQvhg_mbR8Usr_

# App environment
NEXT_PUBLIC_APP_ENV=development

# Sentry (optional in dev)
NEXT_PUBLIC_SENTRY_DSN=

# ── Server-only (NEVER exposed to client) ──────────────────────────────
# Used for migrations, seeds, and server-side admin operations only.
# ESLint rule blocks these outside src/lib/server.
SUPABASE_PROJECT_ID=achswnzuqutjxdhpnacs
SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@localhost:54322/postgres

# Sentry server auth (CI source map uploads)
SENTRY_AUTH_TOKEN=

# HMAC for content pack manifest integrity
CONTENT_PACK_SIGNING_SECRET=generate-a-random-secret

# Figma token — local dev only (Session 2 design sync); never in CI/Vercel
FIGMA_TOKEN=
